#!/bin/sh /etc/rc.common
# Сервис ядра clash-rs.
#
# В OpenWrt пакета clash-rs нет, а значит нет и init-скрипта - в отличие от
# sing-box, у которого свой /etc/init.d/sing-box приезжает вместе с пакетом, и
# подкоп только правит его UCI-настройки (sing_box_configure_service: включает
# сервис, ставит пользователя root и путь к конфигу). Здесь тот же слой писать
# приходится самим.
#
# Отличие от sing-box сознательное: своей UCI-секции у этого сервиса нет.
# Путь к конфигу - вопрос, на который в подкопе уже отвечает core_config_path в
# /usr/lib/podkop/core.sh, и заводить рядом вторую настройку означало бы завести
# второе место, где она может разъехаться с первой.
#
# shellcheck shell=ash
# shellcheck disable=SC2034,SC2154

START=99
STOP=10
USE_PROCD=1

NAME=clash-rs
PROG=/usr/bin/clash-rs
PIDFILE=/var/run/clash-rs.pid
PODKOP_CORE_LIB=/usr/lib/podkop/core.sh

#######################################
# Путь к конфигу clash-rs.
#
# Берётся из слоя ядра, а не собирается здесь заново. core_config_path отвечает
# про АКТИВНОЕ ядро, поэтому core_is_clash подменяется заглушкой: этот
# init-скрипт существует только ради clash-rs, и когда его зовут, конфиг нужен
# именно клэшевый - даже если podkop.settings.core сейчас указывает на sing-box
# (пользователь переключился, а сервис ещё не остановлен).
#
# Если слоя ядра нет (пакет podkop снесли, скрипт остался) - путь по умолчанию.
#######################################
clash_rs_config_path() {
	if [ ! -r "$PODKOP_CORE_LIB" ]; then
		echo "/etc/clash-rs/config.json"
		return 0
	fi

	# shellcheck source=/dev/null
	. "$PODKOP_CORE_LIB"
	core_is_clash() { return 0; }

	core_config_path
}

start_service() {
	local conffile workdir

	conffile="$(clash_rs_config_path)"
	workdir="$(dirname "$conffile")"

	if [ ! -x "$PROG" ]; then
		echo "clash-rs не установлен: $PROG. Поставьте ядро: podkop install_core" >&2
		logger -t "$NAME" "[error] бинарник $PROG отсутствует, стартовать нечем"
		return 1
	fi

	# Без конфига стартовать нельзя, и это не придирка: clash-rs при
	# отсутствующем файле молча СОЗДАЁТ шаблон из одной строки "port: 7890" и
	# поднимается с ним. Роутер в таком виде выглядит работающим, а весь трафик
	# идёт мимо туннеля - худший из возможных исходов.
	if [ ! -f "$conffile" ]; then
		echo "нет конфига $conffile. Сгенерируйте его: podkop restart" >&2
		logger -t "$NAME" "[error] конфиг $conffile отсутствует, старт отменён"
		return 1
	fi

	mkdir -p "$workdir"

	procd_open_instance "$NAME"
	# -d задаёт рабочий каталог: рядом с конфигом clash-rs держит своё
	# состояние (store-selected, кэш fake-ip), и класть его в чужое место,
	# отличное от каталога конфига, незачем.
	procd_set_param command "$PROG" -d "$workdir" -f "$conffile"

	# procd следит за конфигом сам: изменился - перезапустит инстанс по reload,
	# и подкопу не нужно угадывать, надо ли рестартовать после регенерации.
	procd_set_param file "$conffile"

	# Ядро у нас новое и необкатанное, падение = роутер без DNS. Перезапуск с
	# порогом: 5 попыток, пауза 5 секунд, окно 3600 секунд.
	procd_set_param respawn 3600 5 5

	# clash-rs держит по паре сокетов на соединение; дефолтные 1024 дескриптора
	# выбираются на десятке активных вкладок
	procd_set_param limits core="unlimited" nofile="65535 65535"

	# На выходе ядро дописывает выбранный узел и кэш fake-ip, дать досохранить
	procd_set_param term_timeout 15

	procd_set_param pidfile "$PIDFILE"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$PIDFILE"
}

reload_service() {
	# Перечитывать конфиг по сигналу clash-rs не умеет: у него нет ни SIGHUP, ни
	# ручки перезагрузки в external-controller. Единственная честная реализация
	# reload - полный перезапуск.
	restart
}
